rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdministrador() {
      return request.auth != null &&
        request.auth.uid == "OCsKdrDfB6h0Ey5RLjiWnvoOWqs1";
    }

    function esCertificador() {
      return request.auth != null &&
        (
          request.auth.uid == "wBCSJ3XfHVaUZPLmC2yJddh5RXx1" ||
          request.auth.uid == "4tdNYgErvlM7NB3hwP933avL3RT2" ||
          request.auth.token.email == "jdesposorio@pj.gob.pe" ||
          request.auth.token.email == "rdavilaaa@pj.gob.pe"
        );
    }

    // Mesa de Partes: firma (Firma ONPE) y culmina la certificación con el
    // SHA-256 definitivo. Se identifica por correo porque, a diferencia de
    // los certificadores, aún no se conoce su UID hasta crear la cuenta.
    function esMesaPartes() {
      return request.auth != null &&
        request.auth.token.email == "archivocsjsanta@pj.gob.pe";
    }

    match /usuarios/{uid} {
      allow read: if esAdministrador() || ((esCertificador() || esMesaPartes()) && request.auth.uid == uid);

      allow create: if
        (esAdministrador() && request.auth.uid == uid) ||
        ((esCertificador() || esMesaPartes()) && request.auth.uid == uid);

      allow update: if
        (esAdministrador() && request.auth.uid == uid) ||
        ((esCertificador() || esMesaPartes()) && request.auth.uid == uid);

      allow delete: if false;
    }

    // Documentos ya sellados por un certificador (carátula + sello) y a la
    // espera de que Mesa de Partes los firme (Firma ONPE) y culmine la
    // certificación con el SHA-256 definitivo. No tienen SHA final: se crean
    // en el paso 1 y se eliminan al completarse el paso 2 en /certificaciones.
    match /pendientesFirma/{certificacionId} {

      allow get: if esAdministrador() || esCertificador() || esMesaPartes();
      allow list: if esAdministrador() || esCertificador() || esMesaPartes();

      allow create: if esCertificador()
        && request.resource.data.certificadorUid == request.auth.uid;

      allow update: if false;
      allow delete: if esAdministrador() || esMesaPartes()
        || (esCertificador() && resource.data.certificadorUid == request.auth.uid);

      match /pdfChunks/{chunkId} {
        allow read: if esAdministrador() || esCertificador() || esMesaPartes();
        allow create: if esCertificador();
        allow update: if false;
        allow delete: if esAdministrador() || esMesaPartes() || esCertificador();
      }
    }

    match /certificaciones/{certificacionId} {

      allow get: if true;
      allow list: if esAdministrador() || esCertificador() || esMesaPartes();

      // El registro definitivo lo crea quien firma y culmina con el SHA:
      // hoy, Mesa de Partes. Se conserva la ruta antigua (el propio
      // certificador crea y firma) por si se necesita en algún caso puntual.
      allow create: if
        (esMesaPartes() && request.resource.data.firmanteUid == request.auth.uid) ||
        (esCertificador() && request.resource.data.certificadorUid == request.auth.uid);

      allow update: if false;
      allow delete: if esAdministrador();

      // Trozos en base64 del PDF certificado (archivado sin Firebase Storage).
      match /pdfChunks/{chunkId} {
        allow read: if esAdministrador() || esCertificador() || esMesaPartes();
        allow create: if esCertificador() || esMesaPartes();
        allow update: if false;
        allow delete: if esAdministrador() || esCertificador() || esMesaPartes();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
