rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdministrador() {
      return request.auth != null &&
        request.auth.uid == "OCsKdrDfB6h0Ey5RLjiWnvoOWqs1";
    }

    function esCertificador() {
      return request.auth != null &&
        (
          request.auth.uid == "wBCSJ3XfHVaUZPLmC2yJddh5RXx1" ||
          request.auth.uid == "4tdNYgErvlM7NB3hwP933avL3RT2"
        );
    }

    match /usuarios/{uid} {
      allow read: if esAdministrador() || (esCertificador() && request.auth.uid == uid);

      allow create: if
        (esAdministrador() && request.auth.uid == uid) ||
        (esCertificador() && request.auth.uid == uid);

      allow update: if
        (esAdministrador() && request.auth.uid == uid) ||
        (esCertificador() && request.auth.uid == uid);

      allow delete: if false;
    }

    match /certificaciones/{certificacionId} {
      // Consulta pública (página verificar.html, enlace/QR de la constancia):
      // cualquiera puede LEER un registro individual si conoce su código
      // (12 caracteres aleatorios). Listar o buscar sigue reservado al personal.
      allow get: if true;
      allow list: if esAdministrador() || esCertificador();

      allow create: if esCertificador()
        && request.resource.data.certificadorUid == request.auth.uid;

      allow update: if false;
      allow delete: if esAdministrador();

      // Fragmentos Base64 del PDF final, respaldado en Firestore en vez de
      // Firebase Storage (que exige el plan de pago Blaze solo para
      // habilitarse). Cada fragmento es un documento independiente dentro
      // de certificaciones/{certificacionId}/archivo/{n}.
      match /archivo/{fragmentoId} {
        // Solo el personal autorizado puede ver/descargar el PDF respaldado
        // (a diferencia del registro, este no es de consulta pública).
        allow get: if esAdministrador() || esCertificador();
        allow list: if esAdministrador() || esCertificador();

        allow create: if esCertificador();
        allow update: if false;
        allow delete: if esAdministrador() || esCertificador();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
